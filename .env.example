# ── Telegram ───────────────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
SUPER_ADMIN_ID=YOUR_TELEGRAM_ID

# ── MySQL Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=proxy
DB_USER=root
DB_PASS=your_password

# ── Proxy Server ───────────────────────────────────────────────────────────────
START_SCRIPT=/root/proxies-bot/start_proxies.sh
SERVER_PY=/root/proxies-bot/server.py
MITMDUMP=/opt/mitmproxy-venv/bin/mitmdump

# ── Auto-detect IP WebApp ──────────────────────────────────────────────────────
IP_DETECT_URL=https://your-site.netlify.app

# ── Proxy Ports ────────────────────────────────────────────────────────────────
PROXY_PORTS=8881,8882,8883,8884,8885,8886,8887,8888,8889,8890

# ── Optional ───────────────────────────────────────────────────────────────────
INSTANCES_DIR=/root/proxies-bot/data
UPLOAD_DIR=/root/proxies-bot/data
PROXY_TOKEN=tokenapi
PROXY_HOST=127.0.0.1
CERT_DOWNLOAD_URL=https://www.mediafire.com/file/iwicl8nb74mkl40/ProxyVip.pem/file
